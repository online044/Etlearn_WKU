{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile, learning statistics, study streak, and academic configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "university": { "type": "string" },
        "department": { "type": "string" },
        "year": { "type": "string" },
        "subjects": { "type": "array" },
        "studyStreak": { "type": "integer" },
        "totalStudyMinutes": { "type": "integer" },
        "isPro": { "type": "boolean" },
        "theme": { "type": "string" },
        "language": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "year", "subjects"]
    },
    "book": {
      "title": "Book",
      "description": "Authentic university curriculum textbook or digital study module.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "university": { "type": "string" },
        "department": { "type": "string" },
        "academicYear": { "type": "string" },
        "course": { "type": "string" },
        "subject": { "type": "string" },
        "unit": { "type": "string" },
        "accessLevel": { "type": "string", "enum": ["free", "pro"] },
        "allowDownload": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "pdfUrl": { "type": "string" },
        "coverUrl": { "type": "string" },
        "fileSize": { "type": "integer" },
        "pageCount": { "type": "integer" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "university", "department", "course", "subject", "status", "accessLevel"]
    },
    "chapter": {
      "title": "Chapter",
      "description": "Textbook chapter with structured learning content, formulas, and diagrams.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "chapterNumber": { "type": "integer" },
        "title": { "type": "string" },
        "intro": { "type": "string" },
        "sections": { "type": "array" },
        "asciiDiagram": { "type": "string" },
        "formulas": { "type": "array" },
        "examAlert": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "bookId", "chapterNumber", "title"]
    },
    "exam": {
      "title": "Exam",
      "description": "Authentic university past exam, midterm, final, or exit exam paper.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "university": { "type": "string" },
        "department": { "type": "string" },
        "academicYear": { "type": "string" },
        "course": { "type": "string" },
        "subject": { "type": "string" },
        "examType": { "type": "string", "enum": ["midterm", "final", "model", "quiz", "exit_exam"] },
        "examYear": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "totalMarks": { "type": "integer" },
        "passingScore": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "accessLevel": { "type": "string", "enum": ["free", "pro"] },
        "allowDownload": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "pdfUrl": { "type": "string" },
        "fileSize": { "type": "integer" },
        "pageCount": { "type": "integer" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "university", "department", "course", "subject", "examType", "examYear", "status", "accessLevel"]
    },
    "question": {
      "title": "Question",
      "description": "Curriculum exam question with bilingual prompt, options, correct answer, and explanation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "questionNumber": { "type": "integer" },
        "text": { "type": "string" },
        "textAmharic": { "type": "string" },
        "options": { "type": "array" },
        "correctAnswerId": { "type": "string" },
        "explanation": { "type": "string" },
        "explanationAmharic": { "type": "string" },
        "difficulty": { "type": "string" },
        "points": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "examId", "questionNumber", "text", "options", "correctAnswerId"]
    },
    "result": {
      "title": "Result",
      "description": "Student exam score, question answers, completion time, and performance analytics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "correctAnswers": { "type": "integer" },
        "percentage": { "type": "integer" },
        "passed": { "type": "boolean" },
        "timeSpentSeconds": { "type": "integer" },
        "answers": { "type": "object" },
        "completedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "examId", "score", "totalQuestions", "correctAnswers"]
    },
    "promotion": {
      "title": "Promotion",
      "description": "A promotional discount code for subscription upgrades.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercentage": { "type": "integer" },
        "fixedDiscountETB": { "type": "integer" },
        "maxUses": { "type": "integer" },
        "usedCount": { "type": "integer" },
        "expiresAt": { "type": "string" },
        "isActive": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "required": ["code", "discountPercentage", "isActive"]
    },
    "study_note": {
      "title": "StudyNote",
      "description": "Authentic university department study note, chapter summary, and lecture guide.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "university": { "type": "string" },
        "department": { "type": "string" },
        "academicYear": { "type": "string" },
        "course": { "type": "string" },
        "subject": { "type": "string" },
        "unit": { "type": "string" },
        "content": { "type": "string" },
        "accessLevel": { "type": "string", "enum": ["free", "pro"] },
        "allowDownload": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "pdfUrl": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "university", "department", "course", "subject", "status", "accessLevel"]
    },
    "announcement": {
      "title": "Announcement",
      "description": "Campus bulletin, system update, or broadcast notice published by the administrator.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "badgeText": { "type": "string" },
        "isImportant": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "status"]
    },
    "activation_code": {
      "title": "ActivationCode",
      "description": "Secure verification and activation code dispatched to student email and verified by Firebase.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["registration", "password_reset"] },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "email", "code", "type", "verified"]
    },
    "auth_session": {
      "title": "AuthSession",
      "description": "Detailed audit log record of student sign-in and sign-out timestamps, session duration, and device information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["signin", "signout"] },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string" },
        "formattedTime": { "type": "string" },
        "ethDate": { "type": "string" },
        "device": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "email", "timestamp"]
    }
  },
  "firestore": {
    "/activation_codes/{codeId}": {
      "schema": "activation_code",
      "description": "Collection of student activation and verification codes verified by Firebase."
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "Collection of student learning profiles, progress, and settings."
    },
    "/books/{bookId}": {
      "schema": "book",
      "description": "Collection of authentic university curriculum textbooks and digital study modules."
    },
    "/chapters/{chapterId}": {
      "schema": "chapter",
      "description": "Collection of structured textbook chapters linked to books."
    },
    "/exams/{examId}": {
      "schema": "exam",
      "description": "Collection of authentic university exam sheets, midterms, finals, and exit exams."
    },
    "/questions/{questionId}": {
      "schema": "question",
      "description": "Collection of exam questions, options, correct answers, and explanations."
    },
    "/results/{resultId}": {
      "schema": "result",
      "description": "Collection of student exam submission results, scores, and answer histories."
    },
    "/notes/{noteId}": {
      "schema": "study_note",
      "description": "Collection of authentic university curriculum study notes, chapter summaries, and lecture notes published by the educator."
    },
    "/promotions/{promoId}": {
      "schema": "promotion",
      "description": "Collection of promotion and discount codes for subscription upgrades."
    },
    "/announcements/{annId}": {
      "schema": "announcement",
      "description": "Collection of platform announcements and campus bulletins published by the administrator."
    },
    "/auth_sessions/{sessionId}": {
      "schema": "auth_session",
      "description": "Collection of student sign-in and sign-out audit trail records permanently preserved in Firestore."
    }
  }
}
