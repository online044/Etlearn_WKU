rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Liveness test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ezrat2116@gmail.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users Schema Validation
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'year', 'subjects'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.year is string && data.year.size() <= 50
        && data.subjects is list;
    }

    // 2. Books Schema Validation
    function isValidBook(data) {
      return data.keys().hasAll(['id', 'title', 'university', 'department', 'course', 'subject', 'status', 'accessLevel'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.university is string && data.university.size() <= 200
        && data.department is string && data.department.size() <= 200
        && data.course is string && data.course.size() <= 200
        && data.subject is string && data.subject.size() <= 200
        && (data.accessLevel == 'free' || data.accessLevel == 'pro')
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived');
    }

    // 3. Chapters Schema Validation
    function isValidChapter(data) {
      return data.keys().hasAll(['id', 'bookId', 'chapterNumber', 'title'])
        && data.id is string && data.id.size() <= 128
        && data.bookId is string && data.bookId.size() <= 128
        && data.chapterNumber is int
        && data.title is string && data.title.size() <= 300;
    }

    // 4. Exams Schema Validation
    function isValidExam(data) {
      return data.keys().hasAll(['id', 'title', 'university', 'department', 'course', 'subject', 'examType', 'examYear', 'status', 'accessLevel'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.university is string && data.university.size() <= 200
        && data.department is string && data.department.size() <= 200
        && data.course is string && data.course.size() <= 200
        && data.subject is string && data.subject.size() <= 200
        && data.examYear is string && data.examYear.size() <= 64
        && (data.accessLevel == 'free' || data.accessLevel == 'pro')
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived');
    }

    // 5. Questions Schema Validation
    function isValidQuestion(data) {
      return data.keys().hasAll(['id', 'examId', 'questionNumber', 'text', 'options', 'correctAnswerId'])
        && data.id is string && data.id.size() <= 128
        && data.examId is string && data.examId.size() <= 128
        && data.questionNumber is int
        && data.text is string && data.text.size() <= 5000
        && data.options is list
        && data.correctAnswerId is string && data.correctAnswerId.size() <= 64;
    }

    // 6. Results Schema Validation
    function isValidResult(data) {
      return data.keys().hasAll(['id', 'userId', 'examId', 'score', 'totalQuestions', 'correctAnswers'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.examId is string && data.examId.size() <= 128
        && data.score is int
        && data.totalQuestions is int
        && data.correctAnswers is int;
    }

    // 7. Promotions Schema Validation
    function isValidPromotion(data) {
      return data.keys().hasAll(['code', 'discountPercentage', 'isActive'])
        && data.code is string && data.code.size() <= 64
        && data.discountPercentage is int
        && data.isActive is bool;
    }

    // 8. Study Notes Schema Validation
    function isValidNote(data) {
      return data.keys().hasAll(['id', 'title', 'university', 'department', 'course', 'subject', 'status', 'accessLevel'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.university is string && data.university.size() <= 200
        && data.department is string && data.department.size() <= 200
        && data.course is string && data.course.size() <= 200
        && data.subject is string && data.subject.size() <= 200
        && (data.accessLevel == 'free' || data.accessLevel == 'pro')
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived');
    }

    // 9. Announcements Schema Validation
    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.message is string && data.message.size() <= 5000
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived');
    }

    // 10. Subjects Schema Validation
    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'department'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.code is string && data.code.size() <= 50
        && data.department is string && data.department.size() <= 200;
    }

    // ================= COLLECTIONS =================

    // 0. Student Activation Codes (Verified by Firebase)
    match /activation_codes/{codeId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Subjects Collection (Curriculum Subjects)
    match /subjects/{subjectId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(subjectId) && isValidSubject(request.resource.data);
      allow delete: if isAdmin();
    }


    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || true;
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 1b. Profiles Collection (Cross-device profile bridge)
    match /profiles/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 2. Books Collection
    match /books/{bookId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && isValidId(bookId) && isValidBook(request.resource.data);
      allow update: if isAdmin() && isValidId(bookId) && isValidBook(request.resource.data);
      allow delete: if isAdmin();
    }

    // 3. Chapters Collection
    match /chapters/{chapterId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(chapterId) && isValidChapter(request.resource.data);
      allow update: if isAdmin() && isValidId(chapterId) && isValidChapter(request.resource.data);
      allow delete: if isAdmin();
    }

    // 4. Exams Collection
    match /exams/{examId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && isValidId(examId) && isValidExam(request.resource.data);
      allow update: if isAdmin() && isValidId(examId) && isValidExam(request.resource.data);
      allow delete: if isAdmin();
    }

    // 5. Questions Collection (Curriculum Questions & Manual Database Questions)
    match /questions/{questionId} {
      allow read, write: if true;
    }
    match /quiz_questions/{questionId} {
      allow read, write: if true;
    }

    // 6. Results Collection
    match /results/{resultId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidId(resultId) && isValidResult(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // 7. Study Notes Collection (Published by Admin)
    match /notes/{noteId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && isValidId(noteId) && isValidNote(request.resource.data);
      allow update: if isAdmin() && isValidId(noteId) && isValidNote(request.resource.data);
      allow delete: if isAdmin();
    }

    // 8. Promotions Collection
    match /promotions/{promoId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidPromotion(request.resource.data);
      allow delete: if isAdmin();
    }

    // 9. Announcements Collection (Platform & Campus Bulletins)
    match /announcements/{annId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(annId) && isValidAnnouncement(request.resource.data);
      allow update: if isAdmin() && isValidId(annId) && isValidAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }

    // 10. Student Auth Sessions (Never forget sign-in and sign-out timestamps)
    match /auth_sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
