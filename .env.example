# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# OPENROUTER_API_KEY: Optional fallback key for OpenRouter API features.
OPENROUTER_API_KEY=

# GROQ_API_KEY: Optional API key for Groq Cloud.
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# SUPABASE INTEGRATION:
# Configure these to pull Grade 12 new curriculum books dynamically from your Supabase database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TELEGRAM MINI APP INTEGRATION:
# Bot Token from @BotFather used to verify Telegram initData HMAC signature
TELEGRAM_BOT_TOKEN=

